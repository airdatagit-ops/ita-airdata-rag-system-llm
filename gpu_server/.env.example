# GPU Inference Server — Environment Variables

# Server binding
GPU_SERVER_HOST=0.0.0.0
GPU_SERVER_PORT=8090

# Optional API key (leave empty to disable auth)
GPU_SERVER_API_KEY=

# Models
# Promoted from rufimelo/Legal-BERTimbau-sts-large-ma-v3 on 2026-04-25.
# See docs/migrations/2026-04-25_BGE_M3_PROMOTION.md.
EMBEDDING_MODEL=BAAI/bge-m3
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base

# Model cache directory (use a partition with enough space)
MODEL_CACHE_DIR=/dados/airdata/models_cache

# Ollama host (if Ollama runs on the same GPU server)
OLLAMA_HOST=http://localhost:11434

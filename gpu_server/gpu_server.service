[Unit]
Description=GPU Inference Server for Aviation RAG System
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
ExecStart=__INSTALL_DIR__/venv/bin/python server.py
Restart=on-failure
RestartSec=10
StandardOutput=append:__INSTALL_DIR__/gpu_server.log
StandardError=append:__INSTALL_DIR__/gpu_server.log

# GPU/CUDA — override in .env if needed
Environment=CUDA_VISIBLE_DEVICES=0
Environment=MODEL_CACHE_DIR=__MODEL_CACHE__
Environment=OLLAMA_MODELS=__OLLAMA_DATA__

[Install]
WantedBy=multi-user.target

# Environment: development | production
# When unset, web/app/config.py applies environment-aware defaults
# (HOST/PORT/RELOAD/ROOT_PATH/API_BASE_URL).
ENVIRONMENT=development

# Web Server Configuration
HOST=127.0.0.1
PORT=8082

# RELOAD defaults: development -> True, production -> False
RELOAD=True

# ROOT_PATH defaults to empty.
# In production we run behind nginx at https://<host>/ragweb/ and set
# ROOT_PATH=/ragweb so FastAPI generates correct URLs and OpenAPI links.
# Leave empty for local dev (served directly at /).
ROOT_PATH=

# API Configuration
# Local dev and prod both call the API on 127.0.0.1; nginx fronts both tiers.
API_BASE_URL=http://127.0.0.1:8083

# Must match the backend's API_KEY (root .env). Generate a strong random
# key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-api-key-here

# Web authentication
# Use AUTH_MODE=api_key for the local fallback login.
# Use AUTH_MODE=drupal_oauth2 to prioritize Drupal OAuth2.
AUTH_MODE=api_key
SESSION_SECRET_KEY=generate-a-random-session-secret
SESSION_COOKIE_SECURE=false

WEB_LOGIN_ENABLED=true
WEB_LOGIN_USERNAME=airdata
WEB_LOGIN_PASSWORD=AirData-M7q9-V2x4-Kp31
WEB_LOGIN_TOKEN_TTL_SECONDS=28800
WEB_LOGIN_COOKIE_NAME=airdata_auth

DRUPAL_OAUTH_BASE_URL=https://www.airdata.ita.br
DRUPAL_OAUTH_CLIENT_ID=id-rag
DRUPAL_OAUTH_CLIENT_SECRET=
DRUPAL_OAUTH_AUTHORIZE_URL=https://www.airdata.ita.br/oauth/authorize
DRUPAL_OAUTH_TOKEN_URL=https://www.airdata.ita.br/oauth/token
DRUPAL_OAUTH_USERINFO_URL=
DRUPAL_OAUTH_SCOPES=openid
DRUPAL_OAUTH_CALLBACK_PATH=/auth/callback
# Match Data/OWL OAuth clients: Drupal redirects back to the public app root.
DRUPAL_OAUTH_REDIRECT_URI=https://chatbot.airdata.ita.br

# Application
APP_NAME=Aviation RAG Web Interface
APP_VERSION=1.0.0

# Operational SQLite database (feedback today, users/flags/config in the future).
# Leave unset to default to <project_root>/data/app.db.
# APP_DB_PATH=

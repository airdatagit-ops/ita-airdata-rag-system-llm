# Environment: development | production
# Controls default values for ROOT_PATH, RELOAD, etc.
ENVIRONMENT=development

# Web Server Configuration
HOST=127.0.0.1
PORT=8082

# Auto-derived from ENVIRONMENT if not set:
#   development -> RELOAD=True,  ROOT_PATH=
#   production  -> RELOAD=False, ROOT_PATH=/ragweb
RELOAD=True
ROOT_PATH=

# API Configuration
# Both environments connect directly to the API server (no nginx proxy)
API_BASE_URL=http://127.0.0.1:8083
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-api-key-here

# Application
APP_NAME=Aviation RAG Web Interface
APP_VERSION=1.0.0

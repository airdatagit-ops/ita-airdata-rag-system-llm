# ========================================
# Aviation RAG System - Environment Variables
# ========================================
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ========================================
# API Security
# ========================================
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secret-api-key-here-generate-random-string

# Authentication mode:
# - api_key: accepts only X-API-Key (default)
# - drupal_oauth2: accepts only Drupal OAuth2 Bearer tokens
# - api_key_or_drupal_oauth2: accepts both during migration
AUTH_MODE=api_key

# Drupal OAuth2 / Simple OAuth configuration (server lessonia)
# Set DRUPAL_OAUTH_BASE_URL to the public HTTPS URL of the Drupal server.
# Typical Simple OAuth endpoints are /oauth/authorize and /oauth/token.
DRUPAL_OAUTH_BASE_URL=https://lessonia.example.edu
DRUPAL_OAUTH_CLIENT_ID=
DRUPAL_OAUTH_CLIENT_SECRET=
DRUPAL_OAUTH_AUTHORIZE_URL=
DRUPAL_OAUTH_TOKEN_URL=
DRUPAL_OAUTH_INTROSPECTION_URL=
DRUPAL_OAUTH_USERINFO_URL=
DRUPAL_OAUTH_SCOPES=openid profile email
DRUPAL_OAUTH_CALLBACK_PATH=/auth/callback
DRUPAL_OAUTH_TIMEOUT=10
DRUPAL_OAUTH_CACHE_TTL=60
SESSION_SECRET_KEY=generate-a-random-session-secret
SESSION_COOKIE_SECURE=true

# Temporary local web login for demos/presentations.
# Keep AUTH_MODE=api_key to protect the Web UI with a signed JWT cookie.
WEB_LOGIN_ENABLED=true
WEB_LOGIN_USERNAME=airdata
WEB_LOGIN_PASSWORD=AirData-M7q9-V2x4-Kp31
WEB_LOGIN_TOKEN_TTL_SECONDS=28800
WEB_LOGIN_COOKIE_NAME=airdata_auth

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limiting (requests per minute)
RATE_LIMIT=100

# ========================================
# Qdrant Configuration
# ========================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=aviation_regulations

# Qdrant API key (if using Qdrant Cloud)
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# ========================================
# Ollama Configuration
# ========================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LLM parameters
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048

# Thinking-model reasoning toggle. Leave empty for the model default.
# Set to "false" to disable the reasoning channel for thinking models like
# gemma4:* (recommended for short / structured outputs such as NL-to-SQL,
# JSON generation, or anything where you don't want num_predict consumed
# by the silent reasoning trace). Also accepts "low" | "medium" | "high".
# LLM_THINK=false

# ========================================
# RAG Pipeline
# ========================================
# Rewriter: rewrites user query into optimized sub-queries
REWRITER_ENABLED=true
REWRITER_MODEL=qwen2.5:7b
REWRITER_TEMPERATURE=0.3
REWRITER_MAX_QUERIES=3
REWRITER_TIMEOUT=60
# Prompt version: v1 (legacy) | v2 (recommended; structured sorts/filters)
REWRITER_PROMPT_VERSION=v2

# Evaluator: cross-encoder relevance scoring
EVALUATOR_ENABLED=true
# Calibrated for bge-reranker-base; for the legacy mmarco-mMiniLMv2-L12 use 35.
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
EVALUATOR_THRESHOLD=55

# Generator: final answer synthesis
GENERATOR_MODEL=gemma4:26b
GENERATOR_GROUNDED_ONLY=true
GENERATOR_TIMEOUT=120
GENERATOR_MAX_DOC_CHARS=0
GENERATOR_MAX_DOCS=7
GENERATOR_MAX_RESPONSE_TOKENS=2048

# ========================================
# Embedding Model
# ========================================
# Promoted from rufimelo/Legal-BERTimbau-sts-large-ma-v3 on 2026-04-25.
# See docs/migrations/2026-04-25_BGE_M3_PROMOTION.md for the A/B study.
# Both models are 1024-d / cosine, but vectors are NOT interchangeable —
# the Qdrant collection MUST be re-indexed before pointing traffic here.
EMBEDDING_MODEL=BAAI/bge-m3
# Keep at 32: BGE-M3 OOMs on the GPU server with batch_size>=128 on long chunks.
EMBEDDING_BATCH_SIZE=32
# Soft hint — BGE-M3 supports up to 8192 subwords; chunker uses words.
EMBEDDING_MAX_LENGTH=512
EMBEDDING_DIMENSION=1024

# Default embedding mode for `make embed`: dense | sparse | hybrid
DEFAULT_EMBEDDING_MODE=hybrid

# ========================================
# Search Configuration
# ========================================
# Number of results to return from vector search (per query)
SEARCH_TOP_K=8

# Minimum similarity score (0-1). Only applied to dense-only search.
# Has NO effect when SEARCH_SPARSE_ENABLED=true (hybrid mode uses RRF scoring).
SEARCH_SCORE_THRESHOLD=0.3

# Enable dense (semantic) search; pair with SEARCH_SPARSE_ENABLED for hybrid RRF
SEARCH_DENSE_ENABLED=true

# Enable sparse (keyword/BM25) search — requires fastembed
SEARCH_SPARSE_ENABLED=true

# Sparse embedding model (used when SEARCH_SPARSE_ENABLED=true)
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# RRF prefetch pool size = SEARCH_TOP_K * SEARCH_PREFETCH_MULTIPLIER (hybrid only)
SEARCH_PREFETCH_MULTIPLIER=3

# When a sub-query carries a sort, fetch SEARCH_TOP_K * this many candidates
# per sub-query, sort in-memory, then cap back to the original pool size.
SEARCH_SORT_FETCH_MULTIPLIER=3

# HNSW index parameters
HNSW_M=16
HNSW_EF_CONSTRUCT=100
HNSW_EF_SEARCH=64

# ========================================
# Chunking Configuration
# ========================================
# Maximum WORDS per chunk (variable is misnamed; chunker measures words, not subwords).
# 270 targets ~480 BGE-M3 subwords on average (subword/word ratio ≈ 1.78), so chunks
# fit inside the bge-reranker-base 512-subword window without silent truncation.
CHUNK_MAX_TOKENS=270

# Overlap between chunks (tokens)
CHUNK_OVERLAP=50

# ========================================
# Temporal Extraction
# ========================================
# Default days to add to publication date if no effective date found
DEFAULT_EFFECTIVE_DAYS=90

# ========================================
# LexML Scraper Configuration
# ========================================
LEXML_API_URL=https://www.lexml.gov.br/sru
LEXML_MAX_RECORDS_PER_PAGE=100

# Keywords for aviation-related documents (comma-separated)
LEXML_KEYWORDS=aviação,aeronave,ANAC,voo,tripulação,piloto,aeroporto

# ========================================
# SISLAER Scraper Configuration (Primary Source)
# ========================================
SISLAER_BASE_URL=https://www.sislaer.fab.mil.br/TerminalWebCENDOC

# Rate limiting: max requests per second (courteous crawling)
SISLAER_MAX_RATE=10

# Concurrent connections
SISLAER_CONCURRENCY=10

# HTTP timeout in seconds
SISLAER_TIMEOUT=30

# Range of codigoRegistro IDs to scan (0 = auto-discover upper bound)
SISLAER_START_ID=1
SISLAER_END_ID=0

# Document types to collect (comma-separated, uppercase for matching).
# PORTARIA and PORTARIA CONJUNTA excluded by default (20K+ mostly administrative).
# Add them back with: SISLAER_DOC_TYPES=...,PORTARIA,PORTARIA CONJUNTA
SISLAER_DOC_TYPES=ICA,DCA,FCA,MCA,NSCA,PCA,RCA,TCA,OCA,ROCA,RICA,RIMA,RMA,NPA,PTA,BCA,BMA,IMA,NOPREP,AVISO,COMUNICADO,NOTA,ORDEM TÉCNICA,ORIENTAÇÃO NORMATIVA,NORMAS DO COMPREP,MANUAL ELETRÔNICO,MANUAL - OUTROS,LEI,LEI COMPLEMENTAR,DECRETO,DECRETO - LEI,RESOLUÇÃO,INSTRUÇÃO NORMATIVA,MEDIDA PROVISÓRIA,CONSTITUIÇÃO FEDERAL,BOLETIM EXTERNO

# ========================================
# PDF Parser Configuration
# ========================================
# Enable OCR for scanned PDFs (requires paddleocr; slower)
ENABLE_OCR=false

# OCR language
OCR_LANGUAGE=por

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO
LOG_FILE=logs/aviation-rag.log
LOG_ROTATION=500 MB
LOG_RETENTION=30 days

# Enable query logging for analysis
LOG_QUERIES=true

# Enable performance profiling
ENABLE_PROFILING=false

# ========================================
# Cache Configuration (Optional)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=3600

# ========================================
# Database Configuration (Optional)
# For metadata storage
# ========================================
# DATABASE_URL=postgresql://aviation_user:password@localhost:5432/aviation_metadata

# ========================================
# Monitoring (Optional)
# ========================================
ENABLE_METRICS=false
PROMETHEUS_PORT=9091

# ========================================
# Development Settings
# ========================================
# Environment: development | production
ENVIRONMENT=development

# Debug mode
DEBUG=true

# Reload on code changes (development only)
RELOAD=true

# ========================================
# Performance Tuning
# ========================================
# Number of workers for API (production)
API_WORKERS=4

# GPU device IDs (comma-separated). Leave empty for automatic detection.
CUDA_VISIBLE_DEVICES=0

# ========================================
# Data Paths
# ========================================
DATA_DIR=./data
PROCESSED_DIR=./data/processed
MODEL_CACHE_DIR=./models_cache

# ========================================
# Pipeline Storage (3-phase architecture)
# ========================================
# SQLite document store (Phase 1 output)
STORE_DB_PATH=./data/store.db

# Parquet embedding store (Phase 2 output)
EMBEDDINGS_DIR=./data/embeddings

# ========================================
# API Configuration
# ========================================
API_HOST=127.0.0.1
API_PORT=8083
API_TITLE=Aviation RAG API
API_VERSION=1.0.0
API_DESCRIPTION=Retrieval-Augmented Generation API for Brazilian Aviation Regulations

# ========================================
# Ingestion Configuration
# ========================================
INGESTION_BATCH_SIZE=100
ENABLE_PARALLEL_PROCESSING=true
NUM_WORKERS=4

# ========================================
# GPU Inference Mode
# ========================================
# "local"  — load models in-process (GPU if available, CPU fallback)
# "remote" — delegate embeddings/rerank/LLM to GPU server via HTTP
# "cpu"    — force CPU-only, no CUDA, no remote
INFERENCE_MODE=local

# GPU server URL (used when INFERENCE_MODE=remote)
# GPU_SERVER_URL=http://your-gpu-server/gpu-api
# GPU_SERVER_API_KEY=

# Timeout for GPU server requests (seconds)
GPU_SERVER_TIMEOUT=120

# ========================================
# Advanced Timeouts
# ========================================
# Timeout for LLM requests (seconds)
LLM_TIMEOUT=60

# Timeout for vector search (seconds)
SEARCH_TIMEOUT=10

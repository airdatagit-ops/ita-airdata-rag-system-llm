# ========================================
# Aviation RAG System - Environment Variables
# ========================================

# ========================================
# SECURITY - IMPORTANTE: Mude estas senhas!
# ========================================
API_KEY=your-super-secret-api-key-change-this

# ========================================
# Qdrant Configuration
# ========================================
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=aviation_regulations

# ========================================
# LLM Configuration
# ========================================
# Escolha o provider: ollama, openai, anthropic
LLM_PROVIDER=ollama

# Ollama Settings (se usar Ollama)
LLM_MODEL=llama3.2
OLLAMA_URL=http://host.docker.internal:11434
# Se Ollama estiver em container, use: http://ollama:11434

# OpenAI Settings (se usar OpenAI)
# OPENAI_API_KEY=sk-your-openai-api-key
# LLM_MODEL=gpt-4

# Anthropic Settings (se usar Claude)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# LLM_MODEL=claude-3-sonnet-20240229

# ========================================
# API RAG Settings
# ========================================
API_HOST=0.0.0.0
API_PORT=8000
RELOAD=False
RATE_LIMIT=10

# CORS - adicione seus domínios
CORS_ORIGINS=http://localhost:8001,https://seu-dominio.com

# ========================================
# Web Application Settings
# ========================================
WEB_HOST=0.0.0.0
WEB_PORT=8001
WEB_RELOAD=False

# API Connection (usado pela Web App para conectar na API RAG)
API_BASE_URL=http://api-rag:8000

# Application Info
APP_NAME=Aviation RAG Web Interface
APP_VERSION=1.0.0

# ========================================
# Optional: Redis Cache
# ========================================
# REDIS_URL=redis://redis:6379
# REDIS_CACHE_TTL=3600

# ========================================
# Optional: PostgreSQL
# ========================================
# POSTGRES_DB=aviation_metadata
# POSTGRES_USER=aviation_user
# POSTGRES_PASSWORD=change_this_password
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# ========================================
# Optional: Monitoring
# ========================================
# PROMETHEUS_ENABLED=true
# GRAFANA_ADMIN_PASSWORD=change_this_password

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO

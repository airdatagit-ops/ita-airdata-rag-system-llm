[Unit]
Description=AirData RAG Web Interface
After=network.target ragapi.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__/web
Environment="PATH=__PROJECT_DIR__/web/venv/bin"
ExecStart=__PROJECT_DIR__/web/venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ragweb

[Install]
WantedBy=multi-user.target

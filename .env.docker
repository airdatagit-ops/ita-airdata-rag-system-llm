# ========================================
# Aviation RAG System - Docker Environment
# ========================================
# Copie este arquivo para .env e ajuste os valores
# Uso: docker-compose -f docker-compose.unified.yml --env-file .env up -d
# ========================================

# ========================================
# API Security
# ========================================
# IMPORTANTE: Gere uma chave segura para produção:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=sua-chave-api-segura-aqui

# ========================================
# Qdrant Configuration
# ========================================
QDRANT_COLLECTION_NAME=aviation_regulations

# ========================================
# Ollama Configuration
# ========================================
# Se Ollama está rodando no HOST (fora do Docker):
OLLAMA_HOST=http://host.docker.internal:11434

# Se Ollama está rodando em container (descomente no docker-compose):
# OLLAMA_HOST=http://ollama:11434

# Modelo do Ollama
OLLAMA_MODEL=llama3.2:3b
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_MODEL=mistral:7b

# ========================================
# LLM Parameters
# ========================================
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_MAX_TOKENS=500
LLM_TIMEOUT=60

# ========================================
# Embedding Model
# ========================================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=512
EMBEDDING_DIMENSION=1024

# ========================================
# Search Configuration
# ========================================
SEARCH_TOP_K=5
SEARCH_SCORE_THRESHOLD=0.3
SEARCH_TIMEOUT=10

# HNSW Parameters
HNSW_M=16
HNSW_EF_CONSTRUCT=100
HNSW_EF_SEARCH=64

# ========================================
# CORS Origins
# ========================================
# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT=100

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO

# ========================================
# Environment
# ========================================
ENVIRONMENT=production
